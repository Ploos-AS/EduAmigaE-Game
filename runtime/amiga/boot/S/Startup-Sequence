; EduAmigaE-Game generated build boot
FailAt 20

Assign C: SYSTEM:C
Assign L: SYSTEM:L
Assign LIBS: SYSTEM:LIBS
Assign DEVS: SYSTEM:DEVS
Assign S: SYSTEM:S
Path C: ADD
Path EVO:Bin ADD

Assign EDUSRC: SRC:
Assign EDUOUT: OUT:
Assign EDURUNTIME: RUNTIME:
Assign EMODULES: EVO:Modules

If NOT EXISTS "EDUSRC:BUILD.SOURCE"
  Echo "missing BUILD.SOURCE" > EDUOUT:BUILD.FAIL
  EndCLI >NIL:
EndIf
If NOT EXISTS "EDUSRC:BUILD.OUTPUT"
  Echo "missing BUILD.OUTPUT" > EDUOUT:BUILD.FAIL
  EndCLI >NIL:
EndIf

Set SOURCE `Type EDUSRC:BUILD.SOURCE`
Set OUTPUT `Type EDUSRC:BUILD.OUTPUT`
Echo "EduAmigaE-Game: building $SOURCE as $OUTPUT"
Execute EDURUNTIME:build.evo "$SOURCE" "$OUTPUT"

If WARN
  Echo "FAIL" > EDUOUT:BUILD.FAIL
Else
  Echo "PASS" > EDUOUT:BUILD.PASS
EndIf

EndCLI >NIL:
