; EduAmigaE-Game Amiga-side E-VO build script
.key SOURCE/A,OUTPUT/A
.bra {
.ket }

FailAt 20

If NOT EXISTS "EDUSRC:{SOURCE}"
  Echo "ERROR: source not found: EDUSRC:{SOURCE}"
  Quit 10
EndIf

CD EDUSRC:
Echo "Compiling {SOURCE} with E-VO"
EVO "{SOURCE}" NOPROGRESS

If WARN
  Echo "ERROR: E-VO compilation failed"
  Quit 20
EndIf

If NOT EXISTS "{OUTPUT}"
  Echo "ERROR: compiler returned success but output is missing: {OUTPUT}"
  Quit 21
EndIf

Copy "{OUTPUT}" "EDUOUT:{OUTPUT}" QUIET
If WARN
  Echo "ERROR: failed to copy output to EDUOUT:"
  Quit 22
EndIf

Echo "Built EDUOUT:{OUTPUT}"
Quit 0
