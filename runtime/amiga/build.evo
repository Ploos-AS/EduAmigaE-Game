; EduAmigaE-Game Amiga-side E-VO build script
.key SOURCE/A
.bra {
.ket }

FailAt 20

If NOT EXISTS "EDUSRC:{SOURCE}"
  Echo "ERROR: source not found: EDUSRC:{SOURCE}"
  Quit 10
EndIf

CD EDUSRC:
Echo "Compiling {SOURCE} with E-VO"
EVO "{SOURCE}" NOPROGRESS

If WARN
  Echo "ERROR: E-VO compilation failed"
  Quit 20
EndIf

; E-VO writes an executable using the source basename without .e.
Set OUTNAME `FilePart "{SOURCE}"`
Set OUTNAME `Echo "$OUTNAME" | Sed "s/.e$//"`

If NOT EXISTS "$OUTNAME"
  Echo "ERROR: compiler returned success but output is missing"
  Quit 21
EndIf

Copy "$OUTNAME" "EDUOUT:$OUTNAME" QUIET
If WARN
  Echo "ERROR: failed to copy output to EDUOUT:"
  Quit 22
EndIf

Echo "Built EDUOUT:$OUTNAME"
Quit 0
