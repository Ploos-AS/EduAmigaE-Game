[fs-uae]
amiga_model = @MODEL@
kickstart_file = @KICKSTART@
chip_memory = @CHIP@
slow_memory = @SLOW@
fullscreen = 0

hard_drive_0 = @BOOT@
hard_drive_0_label = BOOT
hard_drive_1 = @SYSTEM@
hard_drive_1_label = SYSTEM
hard_drive_2 = @ARTIFACTS@
hard_drive_2_label = TEST
hard_drive_3 = @RESULT@
hard_drive_3_label = RESULT
