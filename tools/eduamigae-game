#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"

stage_source() {
  src="$1"
  test -f "$src"
  mkdir -p "$root/build/src" "$root/build/out"
  cp "$src" "$root/build/src/"
  echo "staged: build/src/$(basename "$src")"
}

verify_hunk() {
  python3 "$root/tools/check-amiga-hunk.py" "$1"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  help)
    cat <<'EOF'
EduAmigaE-Game build helper

Commands:
  doctor              inspect host prerequisites
  stage SOURCE.e      stage E source
  build SOURCE.e      build and verify Amiga Hunk output
  verify FILE         verify an Amiga Hunk executable

Environment:
  EDUAMIGAE_RUNNER    executable implementing the Amiga build-runner contract
EOF
    ;;
  doctor)
    command -v sha256sum >/dev/null
    command -v git >/dev/null
    command -v python3 >/dev/null
    echo "host tools: ok"
    if [ -n "${EDUAMIGAE_RUNNER:-}" ]; then
      echo "Amiga runner: configured ($EDUAMIGAE_RUNNER)"
    else
      echo "Amiga runner: not configured"
    fi
    ;;
  stage)
    src="${1:?usage: eduamigae-game stage SOURCE.e}"
    stage_source "$src"
    ;;
  verify)
    file="${1:?usage: eduamigae-game verify FILE}"
    verify_hunk "$file"
    ;;
  build)
    src="${1:?usage: eduamigae-game build SOURCE.e}"
    base="$(basename "$src")"
    out="${base%.e}"

    stage_source "$src"
    rm -f "$root/build/out/$out"

    if [ -z "${EDUAMIGAE_RUNNER:-}" ]; then
      echo "error: EDUAMIGAE_RUNNER is not configured" >&2
      exit 3
    fi

    test -x "$EDUAMIGAE_RUNNER" || {
      echo "error: EDUAMIGAE_RUNNER is not executable: $EDUAMIGAE_RUNNER" >&2
      exit 5
    }

    "$EDUAMIGAE_RUNNER" "$base"

    test -f "$root/build/out/$out" || {
      echo "error: expected output missing: build/out/$out" >&2
      exit 4
    }

    verify_hunk "$root/build/out/$out"
    echo "build verified: build/out/$out"
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exit 2
    ;;
esac
